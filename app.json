{
  "expo": {
    "name": "Stray Paws",
    "slug": "stray-paws-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d2b1b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.straypaws.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Stray Paws uses your location to show lost pet notices near you."
      }
    },
    "android": {
      "package": "com.straypaws.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d2b1b"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stray Paws uses your location to show lost pet notices near you."
        }
      ]
    ]
  }
}
